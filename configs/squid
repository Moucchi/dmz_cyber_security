echo "
http_port 3128
http_port 3129 transparent

visible_hostname ubuntu-firewall-1

acl localnet src 19.4.3.0/29
acl SSL_ports port 443
acl Safe_ports port 80 443 21 1025-65535

http_access allow localnet
http_access allow localhost
http_access deny !Safe_ports
http_access deny CONNECT !SSL_ports
http_access deny all

url_rewrite_program /usr/bin/squidGuard -c /etc/squidguard/squidGuard.conf
url_rewrite_children 2 startup=0 idle=1 concurrency=0

cache_log /var/log/squid/cache.log
access_log /var/log/squid/access.log" > /etc/squid/squid.conf

chown -R proxy:proxy /var/log/squid
chown -R proxy:proxy /var/spool/squid
chmod -R 755 /var/spool/squid
